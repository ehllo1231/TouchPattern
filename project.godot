; RINNER — open this file with Godot 4.7.2 (standard / GDScript).
config_version=5

[application]
config/name="RINNER"
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/TouchPattern"
config/custom_user_dir_name.windows="Godot/app_userdata/TouchPattern"
config/custom_user_dir_name.macos="Godot/app_userdata/TouchPattern"
run/main_scene="res://scenes/app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=540
window/size/window_height_override=960
window/size/min_width=320
window/size/min_height=568
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.078, 1)
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]

pad_top_left={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":2)]
}
pad_top_right={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":3)]
}
pad_bottom_left={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":0)]
}
pad_bottom_right={
"deadzone": 0.5,
"events": [Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}

[input_devices]
pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[audio]
driver/output_latency=20

